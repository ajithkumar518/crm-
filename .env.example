# ─── Database Provider ──────────────────────────────────────────────────────
# Controls which Prisma schema is used.
# "mysql"       → Local development  → prisma/schema.mysql.prisma
# "sqlserver"   → Production hosting → prisma/schema.sqlserver.prisma
DB_PROVIDER="mysql"

# ─── Database Connection ─────────────────────────────────────────────────────

# MySQL (local development):
# DATABASE_URL="mysql://root:your_password@localhost:3306/suki_crm"

# MS SQL Server (production/hosting):
# DATABASE_URL="sqlserver://<server>:1433;database=suki_marketing_crm;user=<user>;password=<password>;encrypt=true;trustServerCertificate=true;"

DATABASE_URL="mysql://root:your_password@localhost:3306/suki_crm"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="your_jwt_secret_here"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_minimum_32_characters_long"

# ─── SuperAdmin Seed ───────────────────────────────────────────────────────────
# Used by `npm run seed:superadmin` to create the first admin account.
# SUPERADMIN_PASSWORD is required; the others are optional.
SUPERADMIN_EMAIL="superadmin@sukisoftware.com"
SUPERADMIN_PASSWORD=""
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_ROLE="SuperAdmin"
SUPERADMIN_COMPANY_NAME="Suki Software"
SUPERADMIN_COMPANY_VARIANT=2
SUPERADMIN_COMPANY_DOMAIN=""
SUPERADMIN_PLAN_LOCKED=false
SUPERADMIN_SERVICE_CRM_ENABLED=false

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Auth Domain & Token Settings ────────────────────────────────────────────
ALLOWED_DOMAIN=sukisoftware.com
RESET_TOKEN_EXPIRY_MINUTES=15
ACTIVATION_TOKEN_EXPIRY_HOURS=24
AUTH_JWT_EXPIRY=30m

# ─── SMTP Email ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sukisoftware.com

# ─── Customer Portal ─────────────────────────────────────────────────────────
CUSTOMER_PORTAL_URL=http://localhost:3000/customer/portal

# ─── Internal Demo Company ───────────────────────────────────────────────────
# Company ID for SUKI Software's own internal account (used for sales demos).
# Only this company can switch CRM variants in Settings. All other companies
# see a locked plan display. Set this per-environment — the ID differs across
# local/crmdev/production databases.
# To find the ID: SELECT id, name FROM Company WHERE name LIKE '%Suki Software%';
INTERNAL_COMPANY_ID=""

# ─── Outlook Integration (Microsoft Graph API) ──────────────────────────────
AZURE_TENANT_ID="your-azure-tenant-id-here"
AZURE_CLIENT_ID="your-azure-client-id-here"
AZURE_CLIENT_SECRET="your-azure-client-secret-here"
OUTLOOK_MAILBOX_EMAIL="sales@sukisoftware.com"
OUTLOOK_SYNC_BATCH_SIZE=20
OUTLOOK_SYNC_API_KEY="suki_crm_outlook_sync_secret_key"

# ─── Inbound Email Poller (Microsoft 365 Graph API) ──────────────────────────
# Microsoft 365 / Exchange Online client credentials from an Azure AD app
# registration. Requires Mail.Read (or Mail.ReadWrite) and IMAP.AccessAsApp
# granted + admin consent.
MS_GRAPH_CLIENT_ID=your-client-id-here
MS_GRAPH_CLIENT_SECRET=your-client-secret-here
MS_GRAPH_TENANT_ID=your-tenant-id-here
MS_GRAPH_MAILBOX=sales@your-domain.com

# ─── LLM Extractor (GLM / Zhipu AI) ──────────────────────────────────────────
# GLM API key from https://open.bigmodel.cn/
LLM_API_KEY=
# OpenAI-compatible base URL (default: https://open.bigmodel.cn/api/paas/v4/)
LLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Model name (default: glm-4-flash)
LLM_MODEL=glm-4-flash

# ─── Cron / Scheduled Task Secrets ───────────────────────────────────────────
# Shared secret to protect cron-style HTTP trigger routes (e.g. /api/cron/email-poll)
CRON_API_SECRET=

# Bearer secret actually read by app/api/cron/* routes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Max unseen emails handled per /api/cron/email-poll run (serverless timeout guard).
INBOUND_MAX_MESSAGES_PER_RUN=25
